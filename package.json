{
  "name": "openufc",
  "version": "0.1.0",
  "productName": "OpenUFC",
  "author": "Suyang Wei",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "Electron platform for laser measurement tools",
  "main": "electron/main.js",
  "scripts": {
    "dev": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "test": "py -B -m pytest -q -p no:cacheprovider",
    "test:js": "node --check electron/main.js && node --check electron/preload.js && node --check electron/smoke.js && node --check ui/renderer.js && node --test tests/test_electron.cjs",
    "smoke": "set ELECTRON_RUN_AS_NODE=&& electron . --smoke",
    "verify": "npm test && npm run test:js && npm run smoke",
    "build:backend": "node scripts/build-backend.cjs",
    "build:icon": "set ELECTRON_RUN_AS_NODE=&& electron scripts/build-icon.cjs",
    "build:win": "npm run build:icon && npm run build:backend && electron-builder --config build/electron-builder-generated.json --win portable --x64"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "lucide-static": "^1.17.0"
  },
  "build": {
    "appId": "cn.edu.pku.openufc",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "ui/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend/openufc-backend",
        "to": "backend"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OpenUFC-${version}-win-x64.exe"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "splashImage": "assets/startup.bmp",
      "unpackDirName": false
    }
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "26.18.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller@5.4.0": true
  }
}
